<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Model\OrderLine" table="order_lines">
        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>

        <many-to-one field="order" target-entity="App\Domain\Model\Order" inversed-by="items">
            <join-column name="order_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <field name="productId" type="string" column="product_id" length="64"/>
        <field name="productName" type="string" column="product_name" length="255"/>
        <field name="unitPriceAmount" type="decimal" column="unit_price" precision="12" scale="2"/>
        <field name="unitPriceCurrency" type="string" column="unit_currency" length="3"/>
        <field name="quantity" type="integer" column="quantity"/>
        <field name="totalPriceAmount" type="decimal" column="total_price" precision="12" scale="2"/>
        <field name="totalPriceCurrency" type="string" column="total_currency" length="3"/>

        <indexes>
            <index name="idx_order_lines_order_id" columns="order_id"/>
            <index name="idx_order_lines_product_id" columns="product_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
